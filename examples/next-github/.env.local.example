# Copy this file to .env.local and fill it in — or skip it entirely and run
#
#   npx cimisy setup github
#
# from this directory, which registers the GitHub App for you (one browser
# confirmation), installs it, and writes .env.local itself. Every deployer
# registers their own App; cimisy never runs a shared one.
#
# Check whatever you end up with using: npx cimisy doctor

# ── Option A: the one-variable form ───────────────────────────────────────
# `cimisy setup github` prints this. It carries every value below —
# including the private key — as one base64url line, so there's nothing to
# transcribe and no multi-line PEM to mangle. Treat it as a secret.
#
# CIMISY_CONFIG=

# ── Option B: the individual variables ────────────────────────────────────
# CIMISY_CONFIG takes precedence if both are set — the two forms never
# merge, so leave these unset if you're using it.

# Opt-in switch. Without it (and without CIMISY_CONFIG) cimisy uses the
# local disk adapter, which is what you want in dev.
CIMISY_SOURCE=github

# "owner/repo" of the repository your content lives in.
CIMISY_GITHUB_REPO=your-org/your-repo
CIMISY_GITHUB_BRANCH=main

# From your GitHub App's settings page.
CIMISY_GITHUB_APP_ID=123456
CIMISY_GITHUB_APP_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
CIMISY_GITHUB_APP_CLIENT_SECRET=

# Paste the full contents of the .pem file GitHub gives you when you
# generate a private key. Either keep it as a real multi-line value (if
# your env loader preserves newlines in quotes) or replace newlines with
# literal \n — cimisy normalizes either form.
CIMISY_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# Any long random string (>= 32 chars) — signs the admin session cookie.
# Generate one with: openssl rand -base64 32
CIMISY_SESSION_SECRET=
